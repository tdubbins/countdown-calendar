# Environment Configuration for Advent Calendar API
# Copy this file to .env and fill in your actual values

# Flask Configuration
SECRET_KEY=your-secret-key-here
DEBUG=True

# Email Configuration (Custom Domain)
SMTP_SERVER=mail.yourdomain.com
SMTP_PORT=587
EMAIL_USER=noreply@yourdomain.com
EMAIL_PASSWORD=your-email-password
MAIL_DEFAULT_SENDER=Advent Calendar <noreply@yourdomain.com>

# Alternative common SMTP configurations:
# For cPanel/shared hosting: mail.yourdomain.com, port 587 with TLS
# For dedicated servers: smtp.yourdomain.com, port 587 with TLS
# For Office 365: smtp.office365.com, port 587 with TLS
# For Outlook.com: smtp-mail.outlook.com, port 587 with TLS

# SSL/TLS Configuration
MAIL_USE_TLS=True
MAIL_USE_SSL=False

# Application Environment
FLASK_ENV=development  # or 'production'

# Database paths (optional - defaults will be used if not set)
# USERS_DB=data/users.json
# CALENDARS_DB=data/calendars.json
# TASKS_DB=data/tasks.json
# EMAIL_TOKENS_DB=data/email_tokens.json