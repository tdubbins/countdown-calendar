# =============================================================================
# Countdown Calendar App - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# =============================================================================
# Application Settings (REQUIRED)
# =============================================================================

# Secret key for JWT token signing
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Environment mode: production or development
FLASK_ENV=production

# =============================================================================
# URL Configuration (REQUIRED for production)
# =============================================================================

# Public URL for email verification links (no trailing slash)
# Used in: "Click here to verify: https://yourdomain.com/verify?token=..."
FRONTEND_URL=https://yourdomain.com

# =============================================================================
# Email Configuration (REQUIRED for user verification)
# =============================================================================

# SMTP server settings
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465

# Use SSL (port 465) or TLS (port 587) - not both
MAIL_USE_SSL=true
MAIL_USE_TLS=false

# SMTP credentials
EMAIL_USER=your@gmail.com
EMAIL_PASSWORD=

# Sender address (defaults to EMAIL_USER if not set)
# MAIL_DEFAULT_SENDER=noreply@yourdomain.com
