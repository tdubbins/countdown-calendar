# Docker Compose Environment Configuration
# Copy this file to .env and configure for your deployment

# REQUIRED: Secret key for JWT token signing (generate a strong random string)
SECRET_KEY=your-super-secret-key-change-this

# REQUIRED: CORS allowed origins (comma-separated for multiple)
CORS_ORIGINS=http://localhost,https://yourdomain.com

# REQUIRED: Frontend URL for email links
FRONTEND_URL=https://yourdomain.com

# REQUIRED: API URL for frontend
VUE_APP_API_BASE_URL=https://yourdomain.com/api

# Email Configuration (for verification emails)
SMTP_SERVER=smtp.yourprovider.com
SMTP_PORT=465
EMAIL_USER=noreply@yourdomain.com
EMAIL_PASSWORD=your-email-password
