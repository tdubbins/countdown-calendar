# =============================================================================
# Countdown Calendar App - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# =============================================================================
# Application Settings (REQUIRED)
# =============================================================================

# Secret key for JWT token signing
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=82509bcce13b50171ab459291877572c68310b5de7932194264886e918445170

# Environment mode: production or development
FLASK_ENV=development

# =============================================================================
# Email Configuration (REQUIRED for user verification)
# =============================================================================

# SMTP server settings
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465

# Use SSL (port 465) or TLS (port 587) - not both
MAIL_USE_SSL=true
MAIL_USE_TLS=false

# SMTP credentials
EMAIL_USER=your@gmail.com
EMAIL_PASSWORD=

# Sender address (defaults to EMAIL_USER if not set)
# MAIL_DEFAULT_SENDER=noreply@yourdomain.com
