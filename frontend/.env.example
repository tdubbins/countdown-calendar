# Frontend Environment Configuration Template
# Copy this file to .env.development or .env.production and configure

# API Base URL - Backend server location
# Leave empty for auto-detection (uses current hostname with port 5001)
# Set explicitly for production or custom configurations
VUE_APP_API_BASE_URL=

# Development example (auto-detect):
# VUE_APP_API_BASE_URL=

# Production example:
# VUE_APP_API_BASE_URL=https://api.yourdomain.com/api
